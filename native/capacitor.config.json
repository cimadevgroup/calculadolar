{
  "appId": "com.modularmango.calculadolar",
  "appName": "Calculadolar",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#000000"
  },
  "android": {
    "backgroundColor": "#000000",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 300,
      "backgroundColor": "#000000",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000"
    }
  }
}
